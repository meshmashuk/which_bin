# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev cache (schedule data, used when Vercel Blob isn't configured)
.data/

# real neighbour addresses for scripts/refresh-schedule.ts --batch (personal data, don't commit)
scripts/neighbours.txt

# typescript
*.tsbuildinfo
next-env.d.ts
